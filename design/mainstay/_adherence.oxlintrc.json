        "selector": "JSXOpeningElement[name.name='CTABanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|lead|primaryLabel|primaryHref|secondaryLabel|secondaryHref|tone|className|key|ref|className|style|children)$/]",
